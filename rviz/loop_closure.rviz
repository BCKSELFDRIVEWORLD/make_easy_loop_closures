Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LoopClosureAssistant
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /loop_closure_assistant/markers
      Value: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
Window Geometry:
  Height: 800
  Width: 1200
