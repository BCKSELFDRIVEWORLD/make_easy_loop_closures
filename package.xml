<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>make_easy_loop_closures</name>
  <version>2.0.0</version>
  <description>
    Make Easy Loop Closures (MELC) - A ROS2 package that guides users during SLAM mapping
    to achieve optimal loop closures. Monitors SLAM Toolbox parameters and detects
    real loop closure events through pose graph analysis.
  </description>

  <maintainer email="bckselfdrive@gmail.com">BCK</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/BCKSELFDRIVEWORLD/make_easy_loop_closures</url>
  <author email="bckselfdrive@gmail.com">BCK</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
